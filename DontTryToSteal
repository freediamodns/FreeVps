list_vps() {
show_banner
docker ps -a \
--filter "label=gorrilacoderz-vps=true" \
--format "Name: {{.Names}} | Status: {{.Status}}"
pause
}

open_vps() {
show_banner

mapfile -t CONTAINERS < <(
docker ps -a --filter "label=gorrilacoderz-vps=true" --format "{{.Names}}"
)

[ ${#CONTAINERS[@]} -eq 0 ] && echo "No VPS found." && pause && return

for i in "${!CONTAINERS[@]}"; do
    echo "$((i+1))) ${CONTAINERS[$i]}"
done

read -p "Select VPS: " CHOICE

docker start "${CONTAINERS[$((CHOICE-1))]}" >/dev/null 2>&1 || true
docker attach "${CONTAINERS[$((CHOICE-1))]}"
}

stop_vps() {
show_banner

mapfile -t CONTAINERS < <(
docker ps --filter "label=gorrilacoderz-vps=true" --format "{{.Names}}"
)

[ ${#CONTAINERS[@]} -eq 0 ] && echo "No running VPS found." && pause && return

for i in "${!CONTAINERS[@]}"; do
    echo "$((i+1))) ${CONTAINERS[$i]}"
done

read -p "Select VPS to stop: " CHOICE
docker stop "${CONTAINERS[$((CHOICE-1))]}"
pause
}

delete_vps() {
show_banner

mapfile -t CONTAINERS < <(
docker ps -a --filter "label=gorrilacoderz-vps=true" --format "{{.Names}}"
)

[ ${#CONTAINERS[@]} -eq 0 ] && echo "No VPS found." && pause && return

for i in "${!CONTAINERS[@]}"; do
    echo "$((i+1))) ${CONTAINERS[$i]}"
done

read -p "Select VPS to delete: " CHOICE
docker rm -f "${CONTAINERS[$((CHOICE-1))]}"
pause
}

while true; do
show_banner

echo "1) Create New VPS"
echo "2) List VPS"
echo "3) Open VPS"
echo "4) Stop VPS"
echo "5) Delete VPS"
echo "6) Exit"
echo

read -p "Choice: " MENU

case $MENU in
    1) create_vps ;;
    2) list_vps ;;
    3) open_vps ;;
    4) stop_vps ;;
    5) delete_vps ;;
    6) exit 0 ;;
    *) echo "Invalid choice"; sleep 1 ;;
esac
done

