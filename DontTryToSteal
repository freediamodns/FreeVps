#!/usr/bin/env bash
set -e

IMAGE="gorrilacoderz-vps"
HOSTNAME_SET="GorrilaCoderz"

ensure_docker() {
    if command -v docker >/dev/null 2>&1; then
        return
    fi

    curl -fsSL https://get.docker.com | sh

    if command -v systemctl >/dev/null 2>&1; then
        sudo systemctl enable docker >/dev/null 2>&1 || true
        sudo systemctl start docker >/dev/null 2>&1 || true
    fi
}

build_image() {
mkdir -p /tmp/gorrilacoderz
cd /tmp/gorrilacoderz

cat > Dockerfile <<EOF
FROM ubuntu:24.04

RUN apt update && \
    apt install -y \
    curl wget sudo nano git unzip zip vim htop tmux screen \
    python3 python3-pip tmate && \
    apt clean

WORKDIR /root

CMD ["bash"]
EOF

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo -n "Installing "
    for i in $(seq 1 30); do
        printf "#"
        sleep 0.08
    done
    echo
    docker build -t "$IMAGE" .
fi
}

run_container() {
NAME="gc-$(date +%s)"

docker run -it \
    --hostname "$HOSTNAME_SET" \
    --name "$NAME" \
    "$IMAGE" \
    bash -lc "cd && tmate -F"
}

ensure_docker
build_image
run_container
