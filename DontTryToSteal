pause(){ read -rp "Press Enter to continue..."; }

build_image(){
mkdir -p /tmp/gorrilacoderz-vps && cd /tmp/gorrilacoderz-vps
cat > Dockerfile <<EOF
FROM ${BASE_IMAGE}
RUN apt update && apt install -y curl wget nano sudo bash git unzip zip tar vim htop screen tmux net-tools iproute2 procps python3 python3-pip nodejs npm ca-certificates && apt clean
CMD ["bash"]
EOF
if ! docker image inspect gorrilacoderz-vps >/dev/null 2>&1; then
  echo -n "Installing "
  for i in $(seq 1 25); do printf "#"; sleep 0.08; done
  echo
  docker build -t gorrilacoderz-vps . >/dev/null
fi
}

select_container(){
mapfile -t CONTAINERS < <(docker ps -a --filter label=gorrilacoderz-vps=true --format "{{.Names}}")
[ ${#CONTAINERS[@]} -eq 0 ] && echo "No VPS found." && return 1
for i in "${!CONTAINERS[@]}"; do echo "$((i+1))) ${CONTAINERS[$i]}"; done
read -rp "Select: " n
SEL="${CONTAINERS[$((n-1))]}"
[ -z "$SEL" ] && return 1
return 0
}

while true; do
show_banner
echo "1) Create VPS"
echo "2) List VPS"
echo "3) Open VPS"
echo "4) Stop VPS"
echo "5) Delete VPS"
echo "6) Exit"
read -rp "Choice: " c
case "$c" in
1)
 echo "1) Ubuntu 24.04"; echo "2) Debian 12"
 read -rp "OS: " o
 [ "$o" = 1 ] && BASE_IMAGE=ubuntu:24.04 || BASE_IMAGE=debian:12
 build_image
 NAME="gc-$(date +%s)"
 docker create --label gorrilacoderz-vps=true --name "$NAME" --hostname "$HOSTNAME_SET" gorrilacoderz-vps >/dev/null
 echo "Container: $NAME"
 echo "Hostname : $HOSTNAME_SET"
 docker start -ai "$NAME"
 ;;
2)
 docker ps -a --filter label=gorrilacoderz-vps=true --format "Name: {{.Names}} | {{.Status}}"
 pause;;
3)
 select_container && docker start "$SEL" >/dev/null 2>&1 || true
 [ -n "$SEL" ] && docker attach "$SEL"
 ;;
4)
 select_container && docker stop "$SEL"
 pause;;
5)
 select_container && docker rm -f "$SEL"
 pause;;
6) exit 0;;
esac
done
